# Runtime data
Simple-PHP-IPAM/data/ipam.sqlite
Simple-PHP-IPAM/data/ipam.sqlite-wal
Simple-PHP-IPAM/data/ipam.sqlite-shm
Simple-PHP-IPAM/data/.db_initialized
Simple-PHP-IPAM/data/tmp/
Simple-PHP-IPAM/data/backups/
Simple-PHP-IPAM/data/sessions/
Simple-PHP-IPAM/data/*.bak
Simple-PHP-IPAM/config.php.bak*

# Composer / dev tools
vendor/
# Allow vendored client-side assets (Open Props, etc.)
!Simple-PHP-IPAM/assets/vendor/

# PHPStan cache
.phpstan/

# PHPUnit cache
.phpunit.cache/
.phpunit.result.cache

# OS
.DS_Store
Thumbs.db

# Playwright test artifacts
test-results/
.playwright-mcp/

# Session/scratch files
.remember/
stubs/
# Website theme — tracked in its own repo (simple-php-ipam-website)
website/
*.png
# Allow Playwright visual regression baselines
!testing/playwright/tests/**/*.png
# Allow brand assets shipped in logo/
!logo/*.png
!releases/*/regression-evidence/**/*.png
.worktrees/

# Pass-X regression-evidence DB snapshots: commit *.sqlite.gz only
releases/*/regression-evidence/*/db-snapshots/*.sqlite

# Backup format library (real, large-DB archives — one per backup format —
# used as a regression-test safety net for tools/decrypt-backup.php and the
# Restore wizard). Generated locally via tests/fixtures/backup-library/generate.php;
# the binary archives + the MANIFEST (which records the fixture credentials) stay
# local. The generator + README are tracked so the library is reproducible.
tests/fixtures/backup-library/archives/
tests/fixtures/backup-library/MANIFEST.md
