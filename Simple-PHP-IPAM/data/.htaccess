# Deny all HTTP access to this directory (Apache 2.4+)
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
# Apache 2.2 fallback
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
Options -Indexes

# Belt-and-suspenders: explicitly block backup/db extensions
<FilesMatch "\.(sqlite|sqlite3|db|sql|bak|gz|tar|zip)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
