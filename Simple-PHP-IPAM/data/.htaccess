# Disable directory indexing (Apache only; configure via WebAdmin for OLS)
Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On

# Belt-and-suspenders: explicitly block backup/db extensions
# (This replaces the <FilesMatch> block which OpenLiteSpeed ignores)
RewriteRule \.(sqlite|sqlite3|db|sql|bak|gz|tar|zip|json|lock)$ - [F,L,NC]

# Deny all HTTP access to this directory
# (This acts as a universally supported "Require all denied")
RewriteRule ^.*$ - [F,L]
</IfModule>

# Fallback for standard Apache just in case mod_rewrite is disabled
<IfModule !mod_rewrite.c>
    # Apache 2.4+
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>

    # Apache 2.2 fallback
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</IfModule>
