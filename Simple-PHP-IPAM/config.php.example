<?php
declare(strict_types=1);

// Simple PHP IPAM — bootstrap configuration.
//
// This file contains ONLY the keys needed before the database is available.
// All other settings live in the settings table and are managed through
// Admin → Settings in the web UI.
//
// Copy this file to config.php and edit the values for your environment.

return [
    // --- Database ---
    // SQLite (default):
    'db_driver' => 'sqlite',
    'db_dsn'    => 'sqlite:' . __DIR__ . '/data/ipam.sqlite',
    'db_user'   => '',
    'db_pass'   => '',

    // MySQL 8.0+:
    // 'db_driver' => 'mysql',
    // 'db_dsn'    => 'mysql:host=127.0.0.1;port=3306;dbname=ipam;charset=utf8mb4',
    // 'db_user'   => 'ipam',
    // 'db_pass'   => 'secret',

    // PostgreSQL 14+:
    // 'db_driver' => 'pgsql',
    // 'db_dsn'    => 'pgsql:host=127.0.0.1;port=5432;dbname=ipam',
    // 'db_user'   => 'ipam',
    // 'db_pass'   => 'secret',

    // --- Session ---
    'session_name' => 'IPAMSESSID',

    // --- HTTPS ---
    'force_https' => true,

    // --- Two-factor authentication (TOTP) ---
    // Required for TOTP 2FA: a long random string used to encrypt each user's TOTP
    // secret at rest. If this value changes, all enrolled users will be unable to log
    // in with their authenticator app until 2FA is reset by an admin. Never leave
    // this empty on a production instance with 2FA enabled.
    // Generate with: php -r "echo bin2hex(random_bytes(32));"
    'app_secret' => '',

    // --- Backup vault key (v3.24.0+) ---
    // Used to encrypt scheduled backups (IPAMBKP3 "stored" mode). Distinct from
    // app_secret: app_secret protects DB-resident data (TOTP secrets, restore
    // tokens), backup_vault_key protects backup files at rest.
    //
    // Auto-generated on first scheduled / stored-mode backup if left empty —
    // the application rewrites this file in place to insert a fresh 32-byte
    // base64 value. To pre-seed manually:
    //   php -r "echo base64_encode(random_bytes(32));"
    //
    // Rotation: changing this value invalidates every existing IPAMBKP3
    // stored-mode backup. Keep a copy alongside (NOT inside) the backup
    // archive set.
    'backup_vault_key' => '',
];
