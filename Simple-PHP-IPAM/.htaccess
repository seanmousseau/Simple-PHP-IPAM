# Upload limits for db_tools.php SQL import.
#
# SQL dumps can be large on installs with long audit history, many subnets,
# or extensive demo seed data. If your dump exceeds these limits, raise
# both values here (they must both be raised — post_max_size must be at
# least slightly larger than upload_max_filesize).
#
# These php_value directives only apply under Apache + mod_php. Under PHP-FPM
# or CGI, set the same values in php.ini or the FPM pool config instead.
php_value upload_max_filesize 512M
php_value post_max_size 520M

# Suppress PHP's request-startup warnings (e.g. "POST Content-Length ...
# exceeds the limit of ..."). Those warnings are written to stdout BEFORE
# any PHP script runs, which commits the HTTP response headers and causes
# a cascade of "headers already sent" errors when init.php later calls
# session_start(). db_tools.php has its own graceful handling for oversized
# uploads via an early CONTENT_LENGTH check — suppressing startup warnings
# lets that handler actually run. Startup errors still go to the PHP error
# log for operators to see.
php_flag display_startup_errors Off

# Options -Indexes works for Apache.
# Note: OpenLiteSpeed ignores this. For OLS, disable "Auto Index" in the WebAdmin Console.
Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On

# Pass Authorization header to PHP (Apache strips it by default for CGI/FastCGI)
RewriteCond %{HTTP:Authorization} .+
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Force HTTPS redirect
# Skip if already HTTPS, or if a trusted proxy has already terminated TLS
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Block direct access to specific PHP and SQL files
RewriteRule ^(config\.php|init\.php|lib\.php|PgsqlStatement\.php|schema\.sql|schema\.mysql\.sql|schema\.pgsql\.sql|migrations\.php|migrate\.php|migrate_db\.php|version\.php|tmp_cleanup\.php|backup\.php|restore\.php)$ - [F,L,NC]

# Block direct access to internal source directories. OpenLiteSpeed's lsphp
# handler dispatches PHP files BEFORE a subdirectory-level .htaccess rewrite
# rule fires, so the per-directory `dialects/.htaccess` and `vendor/.htaccess`
# deny rules do not block direct execution of .php files under those paths
# on OLS. Blocking at the ROOT context closes the gap because root-level
# rewrite rules run before handler dispatch on both Apache and OLS.
# v2.11.0 #500. See testing/playwright/tests/htaccess.spec.ts and the
# containerized OLS regression guard in playwright.yml.
RewriteRule ^dialects(/|$) - [F,L,NC]
RewriteRule ^vendor(/|$) - [F,L,NC]

# Block download of upgrade/build artifacts, scripts, and databases
RewriteRule \.(sh|tar\.gz|tgz|zip|sqlite|db|txt|tar|sql)$ - [F,L,NC]
RewriteRule (^|/)SHA256SUMS$ - [F,L,NC]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Frame-Options "DENY"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
# CSP is set per-page by PHP (page_header() / demo_gate.php) so that per-page
# script-src / frame-src extensions (e.g. Turnstile, hCaptcha, reCAPTCHA) work
# correctly. Do not add a global CSP here — it would be enforced alongside the
# PHP header (browsers apply all CSP policies simultaneously, most-restrictive wins),
# blocking external CAPTCHA scripts and iframes.

# Only enable HSTS if you're sure you will keep HTTPS
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>
