includes:
    - phpstan-baseline.neon

parameters:
    phpVersion: 80200
    level: 9
    paths:
        - Simple-PHP-IPAM
    excludePaths:
        - Simple-PHP-IPAM/data
    bootstrapFiles:
        - Simple-PHP-IPAM/version.php
    typeAliases:
        LoginProtectionConfig: 'array{login_protection: array{method: string|null, site_key: string, secret_key: string, min_seconds: int, version: int}}'
        IpamConfig: 'array{db_path: string, session_name: string, proxy_trust: bool, app_name: string, timezone?: string, base_url?: string|null, bootstrap_admin: array{username: string, password: string}, session_idle_seconds: int, login_max_attempts: int, login_lockout_seconds: int, import_csv_max_mb: int, import_sql_max_mb?: int, tmp_cleanup_ttl_seconds: int, audit_log_retention_days: int, address_history_retention_days: int, housekeeping: array{enabled: bool, interval_seconds: int}, utilization_warn: int, utilization_critical: int, update_check: array{enabled: bool, ttl_seconds: int, notify_prerelease: bool}, backup: array{enabled: bool, frequency: string, retention: int, dir: string}, password_policy: array{min_length: int, require_uppercase: bool, require_lowercase: bool, require_number: bool, require_symbol: bool, max_password_age_days: int}, login_protection: array{method: string|null, site_key: string, secret_key: string, min_seconds: int, version: int}, demo_mode: array{enabled: bool, gate: string|null, site_key: string, secret_key: string}, oidc: array{enabled: bool, display_name: string, client_id: string, client_secret: string, discovery_url: string, redirect_uri: string, scopes: string, auto_link: bool, auto_provision: bool, default_role: string, disable_local_login: bool, hide_emergency_link: bool, disable_emergency_bypass: bool}, api_max_attempts?: int, api_lockout_seconds?: int, api_bulk_limit?: int, recaptcha_enterprise: array{enabled: bool, project_id: string, api_key: string, expected_action: string, score_threshold: float}, auto_reserve_network_broadcast?: bool, alert_email?: string, alert_util_warn_pct?: int, alert_util_crit_pct?: int, alert_interval_seconds?: int, recaptcha_action?: string, status_hide_version?: bool, db_driver?: string, session_cookie_path?: string, account_lockout_max_attempts?: int, account_lockout_seconds?: int, recovery_mode?: bool}'
